{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "paths": {
      "#bot-detector": [
        "./server/bot_detector/stub.ts"
      ]
    }
  },
  "files": [
    "src/main.ts",
    "src/product/env.d.ts",
    "tests/smoke.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}
