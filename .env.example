# Production example: supply secrets through your deployment, never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=8788
DATABASE_URL=postgres://CHANGE_USER:CHANGE_PASSWORD@CHANGE_HOST:5432/CHANGE_DATABASE
REALM_NAME=RPGWorld
RPG_WORLD=placeholder
ALLOW_DEV_COMMANDS=0
WOC_MARKET_ENABLED=0
# Original auth/security/integration configuration is documented in upstream/DEPLOY.md.
# Local development: pnpm dev generates .cache/local.env with a random isolated DB password.
